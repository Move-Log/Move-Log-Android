<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginVertical="16dp"
        android:layout_marginHorizontal="8dp"
        android:background="@drawable/ic_arrow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/et_search"
        android:contentDescription="@string/logo" />
    
    <EditText
        android:id="@+id/et_search"
        android:layout_width="0dp"
        android:layout_height="40dp"
        style="@style/ibm_plex_l3"
        android:textColor="@color/gray_35"
        android:textColorHint="@color/gray_7f"
        android:hint="명사를 입력해주세요."
        android:paddingHorizontal="16dp"
        android:inputType="text"
        app:layout_constraintStart_toEndOf="@id/iv_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_back"
        app:layout_constraintBottom_toBottomOf="@id/iv_back"
        android:layout_marginEnd="16dp"
        android:background="@drawable/selector_word_input"
        tools:ignore="Autofill" />

    <ImageButton
        android:id="@+id/ib_clear"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_close"
        android:background="@null"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="@id/et_search"
        app:layout_constraintBottom_toBottomOf="@id/et_search"
        app:layout_constraintEnd_toEndOf="@id/et_search"
        android:layout_margin="16dp"
        android:visibility="gone"/>

    <ImageButton
        android:id="@+id/ib_search"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_search"
        android:background="@null"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="@id/et_search"
        app:layout_constraintBottom_toBottomOf="@id/et_search"
        app:layout_constraintEnd_toEndOf="@id/et_search"
        android:layout_margin="16dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tv_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="검색 결과"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/et_search"
        android:layout_marginStart="16dp"
        style="@style/ibm_plex_l5"
        android:textColor="@color/gray_4d"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search_result"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tv_result"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        tools:listitem="@layout/item_noun_search_result"/>
</androidx.constraintlayout.widget.ConstraintLayout>